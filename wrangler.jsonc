{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "web-app999",
  "main": "worker.js",
  "compatibility_date": "2026-07-30",
  "compatibility_flags": ["nodejs_compat"],
  "d1_databases": [
    { "binding": "DB","database_id": "341cdd24-92f1-4584-a02b-5cb2dd3aad1c","database_name": "tropica" }
  ],
  "kv_namespaces": [
    { "binding": "KV","id": "327876076cc24bc48c1c758a3b63e108" }
  ],
  "workers_dev": true,
  "preview_urls": true,
  "observability": {
    "enabled": true,
    "logs": {
      "enabled": true,
      "head_sampling_rate": 1,
      "invocation_logs": true
    },
    "traces": {
      "enabled": true,
      "head_sampling_rate": 0.01
    }
  }
}
